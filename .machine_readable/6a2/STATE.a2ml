# STATE.a2ml — Project state checkpoint

[metadata]
project = "cleave"
version = "0.1.0"
last-updated = "2026-06-16"
status = "active"  # active | paused | archived

[project-context]
name = "cleave"
purpose = "Transmutable interface-engine library: a dial from raw FFI-ABI through sandboxed (SNIF) to a unified Groove protocol, over a well-founded, self-dual, zero-residue teardown backbone."
completion-percentage = 5

[position]
phase = "design"           # design | implementation | testing | maintenance | archived
maturity = "experimental"  # experimental | alpha | beta | production | lts

[route-to-mvp]
milestones = [
  { name = "Phase 0: Scaffold + spec rehome (file-set, machine-readable, RANKED-OWNERSHIP-CLEAVE, PROOF-NEEDS, dial design, transmute-security)", completion = 80 },
  { name = "Phase 1: Rehome genuinely-generic proofs from gossamer (Groove.idr/GrooveTermination.idr); rebuild wiring fresh (NOT lift the phantom)", completion = 0 },
  { name = "Phase 2: Linear handle newtype (not bare I64); tree-ranked Dershowitz-Manna teardown (upgrade flat-LIFO)", completion = 0 },
  { name = "Phase 3: Wire ResourceCleanup descent to real teardown (RC-7/RC-8); make RC-1..13 load-bearing via a real owns-graph", completion = 0 },
  { name = "Phase 4: Transmute-mode security layer (transaction-gating + mode-permission + preemptability) — newer than RC-1..13", completion = 0 },
  { name = "Phase 5: DEMONSTRATED bar — wire a SECOND end-to-end point (real capability, soft AND hard, teardown invoked, handle actually linear, proof guarding running code)", completion = 0 },
]

[blockers-and-issues]
